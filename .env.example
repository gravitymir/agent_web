# Copy to `.env` and fill in your keys. `.env` is git-ignored.
# Native agent engine config (loaded automatically at startup by main.rs).

# Engine and active provider are chosen in the interactive startup wizard (when
# launched from a terminal). Set them here only to override / skip the menu:
# CWI_ENGINE=native            # `native` = built-in /v1/messages agent; `cli` = Claude Code
# CWI_AGENT_PROVIDER=kimi      # anthropic | kimi | glm | qwen | gemini

# Per-provider API keys (only the active provider's key is needed).
CWI_AGENT_KIMI_API_KEY=
CWI_AGENT_GLM_API_KEY=
CWI_AGENT_CLAUDE_API_KEY=
# Qwen (Alibaba) API key from Model Studio / DashScope:
#   https://bailian.console.alibabacloud.com/  (International: click "API-KEY")
# Anthropic-compatible endpoint, same wire format as Kimi/GLM (no adapter needed).
CWI_AGENT_QWEN_API_KEY=
# Gemini API key from https://aistudio.google.com/app/apikey (pay-per-token —
# a Google AI Pro/Ultra subscription does NOT cover API usage, only Gemini CLI,
# and Gemini's own wire format needed a translation adapter — see agent/gemini.rs).
CWI_AGENT_GEMINI_API_KEY=

# Show reasoning (thinking) where the provider supports it.
CWI_AGENT_THINKING=1

# Optional overrides:
# CWI_AGENT_MODEL=kimi-k2.7-code
# CWI_AGENT_BASE_URL=
# CWI_AGENT_MAX_TOKENS=8192

# --- Storage & workspace (portable by default) ---
# By default the app is portable: chats/metadata go to `chats/` next to the exe,
# and the agent's workspace is `workspace/` next to the exe (created on start).
# Set these only to override those defaults:
# CWI_WORKSPACE=C:\path\to\workspace   # where the agent reads/writes code
# CLAUDE_CONFIG_DIR=...                 # storage root (chats + credentials)
#
# CLAUDE_CONFIG_DIR also isolates the app (and the `claude` subprocess it spawns)
# from your desktop/terminal Claude — the CLI reads this var itself and the child
# inherits it. The portable default (<exe_dir>\chats) already keeps them separate.
# The isolated dir has no saved login, so for the CLI/subscription engine provide
# a token once:  claude setup-token   (token lives ~1 year)
# CLAUDE_CODE_OAUTH_TOKEN=

# --- Built-in access gate (optional) ---
# Guard the whole app (incl. /ws) behind time-limited access codes — a magic link
# plus a manual code — independent of any external login/tunnel. Off by default.
# The executor VM runs with this ON (guests reach it only via a magic link).
# CWI_AUTH=1
# Base URL used in the magic links printed by `agent_web guest new`:
# CWI_PUBLIC_URL=https://agent.example.com
# Manage codes from the CLI (owner):
#   agent_web guest new --ttl 24h --label "Vasya"   # prints code + magic link
#   agent_web guest list
#   agent_web guest revoke Vasya

# --- Admin instance & guest magic-links (managed from the master web page) ---
# `admin` instances expose the "Ссылки" tab (mint/list/revoke guest links) and
# executor VM control. Defaults to "the gate above is off" (owner host); the
# executor sets CWI_AUTH=1 so it is a guest and admin routes there return 403.
# Set explicitly only to override that default:
# CWI_ADMIN=1
# Base URL baked into guest magic-links minted in the admin tab — the *guest*
# tunnel, not the admin host (falls back to CWI_PUBLIC_URL, else localhost:8788):
# CWI_GUEST_URL=https://guest.example.com

# --- Qwen Code engine (Alibaba ModelStudio Token Plan) -----------------------
# Run the CLI engine on Qwen Code instead of Claude Code: set CWI_ENGINE=cli and
# point CWI_CLAUDE_BIN at the qwen binary (the "qwen" in its name switches the
# spawner to qwen-compatible flags). agent_web then maps the Token Plan key below
# onto qwen's openai auth headlessly — no `/auth` setup inside qwen is needed.
# CWI_CLAUDE_BIN=C:\Users\you\AppData\Local\qwen-code\bin\qwen.cmd
# Plan-Specific API Key: ModelStudio console → My Subscriptions → Generate.
# BAILIAN_TOKEN_PLAN_API_KEY=sk-...
# Optional overrides (defaults: the plan's Singapore endpoint + qwen3.7-plus;
# other plan models: qwen3.7-max, qwen3.8-max, qwen3.6-plus, qwen3.6-flash):
# CWI_QWEN_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# CWI_QWEN_MODEL=qwen3.7-plus
