# Copy to `.env` and fill in your keys. `.env` is git-ignored.
# Native agent engine config (loaded automatically at startup by main.rs).

# Engine: `native` uses the built-in /v1/messages agent; `cli` uses Claude Code.
CWI_ENGINE=native

# Active provider: anthropic | kimi | glm
CWI_AGENT_PROVIDER=kimi

# Per-provider API keys (only the active provider's key is needed).
CWI_AGENT_KIMI_API_KEY=
CWI_AGENT_GLM_API_KEY=
CWI_AGENT_CLAUDE_API_KEY=

# Show reasoning (thinking) where the provider supports it.
CWI_AGENT_THINKING=1

# Optional overrides:
# CWI_AGENT_MODEL=kimi-k2.7-code
# CWI_AGENT_BASE_URL=
# CWI_AGENT_MAX_TOKENS=8192

# --- Isolation from desktop/terminal Claude (CLI engine only) ---
# Point the app (and the `claude` subprocess it spawns) at a DEDICATED config
# dir so its sessions and history never mix with your desktop/terminal Claude.
# The `claude` CLI reads CLAUDE_CONFIG_DIR itself; the child inherits it.
# Because the isolated dir has no saved login, provide a subscription token:
#   run once:  claude setup-token   (token lives ~1 year)
# Leave both unset to share the default ~/.claude.
# CLAUDE_CONFIG_DIR=C:\Users\you\.agent_web
# CLAUDE_CODE_OAUTH_TOKEN=
