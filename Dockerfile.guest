# Guest sandbox image — SUBSCRIPTION variant (CLI engine).
#
# Runs the official Claude Code CLI (Node) so guests use YOUR Claude subscription
# (5h/weekly limits), inside a locked-down container. The subscription token is
# passed via env; the model can't reach it because Claude Code's own permission
# system (baked in as un-overridable managed-settings) denies Bash, web, MCP and
# any file access outside /workspace — including /proc/self/environ.
#
# Build:  docker build -f Dockerfile.guest -t agent-web:guest-sub .
# Run:    ./run-guest.ps1   (reads CLAUDE_CODE_OAUTH_TOKEN from .env)

# ---- build: static musl binary of our app ----
FROM rust:alpine AS build
RUN apk add --no-cache musl-dev
WORKDIR /src
COPY . .
RUN cargo build --release

# ---- runtime: Node + official claude CLI + our binary ----
FROM node:22-bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates iptables gosu \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g @anthropic-ai/claude-code \
    && npm cache clean --force

# Un-overridable Claude Code lockdown (highest precedence; root-owned so the
# guest process — running as uid 10001 — cannot modify it).
RUN mkdir -p /etc/claude-code
COPY docker/managed-settings.json /etc/claude-code/managed-settings.json
RUN chmod 0644 /etc/claude-code/managed-settings.json

# Non-root guest + writable data dirs (root FS is mounted read-only at run time).
RUN useradd -u 10001 -m -d /home/guest -s /usr/sbin/nologin guest \
    && mkdir -p /chats /workspace \
    && chown -R guest:guest /chats /workspace

WORKDIR /app
COPY --from=build /src/target/release/agent_web ./agent_web
COPY static ./static
# Entrypoint installs egress rules as root, then drops to 'guest' (via gosu) —
# so no `USER guest` here; the app still runs unprivileged.
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod 0755 /entrypoint.sh

# CLI/subscription engine; access gate on; default-deny permissions (belt-and-
# suspenders with managed defaultMode); token + storage via env/mounts at run.
ENV CWI_NO_MENU=1 \
    CWI_ENGINE=cli \
    CWI_AUTH=1 \
    CWI_BIND=0.0.0.0:8787 \
    CWI_WORKSPACE=/workspace \
    CWI_PERMISSION_MODE=dontAsk \
    CLAUDE_CONFIG_DIR=/chats \
    HOME=/chats
EXPOSE 8787
ENTRYPOINT ["/entrypoint.sh"]
