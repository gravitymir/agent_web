# Copy to `guest.env` and fill in a DEDICATED guest key. This file is passed to
# the guest container via --env-file. NEVER put your owner OAuth token or main
# keys here — a guest with agent access can read whatever is in this env.

# Native provider for guests: anthropic | kimi | glm | gemini
CWI_AGENT_PROVIDER=gemini

# A separate, revocable, rate-limited key for guests (not your primary key):
CWI_AGENT_GEMINI_API_KEY=

# Show reasoning where supported.
CWI_AGENT_THINKING=1

# Public base URL for the magic links printed by `guest new` (your guest tunnel):
CWI_PUBLIC_URL=https://guest.astechlab.dev
